# Experimental product I1. Select it explicitly: mdf --env-file /percorso/.env ...
# Precedence: defaults < explicit file < environment < administrative CLI arguments.
# Unknown MDF names and invalid values cause an error. No secret needed.
MDF_DATA_ROOT=./mdf-data
# Five Marker/Surya checkpoints and two fonts already prepared; no automatic download.
MDF_MODEL_ROOT=./mdf-models
MDF_HOST=127.0.0.1
MDF_PORT=8765
MDF_BIND_PROFILE=marker-cpu-v1
MDF_REVIEW_PROVIDER=disabled
# Total deadline of a conversion in seconds; 0 = none (default): stop it with Annulla (Cancel).
MDF_TIMEOUT_SECONDS=0
# Stop a conversion whose engine progress has not advanced for this long (minimum 60).
# 900 is an initial default measured on one document and one laptop, not a guarantee.
MDF_STALL_SECONDS=900
# RLIMIT_AS per process and sampled aggregate RSS guard: not an aggregate hard cap.
MDF_MEMORY_MIB=16384
MDF_THREADS=4
MDF_PROCESS_LIMIT=512
MDF_UPLOAD_MIB=50
MDF_MAX_PAGES=50
MDF_OUTPUT_MIB=512
MDF_LOG_MIB=10
# Archive quota, without automatic deletion; free reserve space kept distinct.
MDF_STORAGE_MIB=20480
MDF_RESERVE_MIB=1024
MDF_MAX_PIXELS=25000000
MDF_MAX_DIMENSION=16000
MDF_POLL_SECONDS=1
MDF_LEASE_SECONDS=15
MDF_GRACE_SECONDS=5
