# Prodotto sperimentale I1. Selezionare esplicitamente: mdf --env-file /percorso/.env ...
# Precedenza: default < file esplicito < ambiente < argomenti amministrativi CLI.
# Nomi MDF sconosciuti e valori non validi causano errore. Nessun segreto necessario.
MDF_DATA_ROOT=./mdf-data
# Cinque checkpoint Marker/Surya e due font già preparati; nessun download automatico.
MDF_MODEL_ROOT=./mdf-models
MDF_HOST=127.0.0.1
MDF_PORT=8765
MDF_BIND_PROFILE=marker-cpu-v1
MDF_REVIEW_PROVIDER=disabled
MDF_TIMEOUT_SECONDS=450
# RLIMIT_AS per processo e guardia RSS aggregata campionata: non hard cap aggregato.
MDF_MEMORY_MIB=16384
MDF_THREADS=4
MDF_PROCESS_LIMIT=512
MDF_UPLOAD_MIB=50
MDF_MAX_PAGES=50
MDF_OUTPUT_MIB=512
MDF_LOG_MIB=10
# Quota archivio, senza cancellazione automatica; spazio libero di riserva distinto.
MDF_STORAGE_MIB=20480
MDF_RESERVE_MIB=1024
MDF_MAX_PIXELS=25000000
MDF_MAX_DIMENSION=16000
MDF_POLL_SECONDS=1
MDF_LEASE_SECONDS=15
MDF_GRACE_SECONDS=5
