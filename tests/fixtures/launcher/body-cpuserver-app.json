{
 "AttachStderr": false,
 "AttachStdin": false,
 "AttachStdout": false,
 "Cmd": [
  "/opt/llama/llama-server",
  "--help"
 ],
 "Entrypoint": [
  "/bin/bash",
  "-c",
  "<supervisor>",
  "mdf-supervise",
  "1200",
  "300",
  "0.1",
  "/ctl",
  "/stat",
  "/sys/fs/cgroup",
  "--"
 ],
 "Env": [
  "HOME=/tmp",
  "LANG=C.UTF-8",
  "LD_LIBRARY_PATH=/opt/llama",
  "PATH=/usr/bin"
 ],
 "HostConfig": {
  "AutoRemove": false,
  "CapDrop": [
   "ALL"
  ],
  "CgroupnsMode": "private",
  "Init": false,
  "IpcMode": "private",
  "LogConfig": {
   "Config": {},
   "Type": "none"
  },
  "Memory": 268435456,
  "MemorySwap": 268435456,
  "Mounts": [
   {
    "ReadOnly": true,
    "Source": "mdf-unit_mdf-work",
    "Target": "/ctl",
    "Type": "volume",
    "VolumeOptions": {
     "NoCopy": true,
     "Subpath": "call/mdf-eng-0123456789abcdef-cpuserver-1/ctl"
    }
   },
   {
    "ReadOnly": false,
    "Source": "mdf-unit_mdf-work",
    "Target": "/stat",
    "Type": "volume",
    "VolumeOptions": {
     "NoCopy": true,
     "Subpath": "call/mdf-eng-0123456789abcdef-cpuserver-1/stat"
    }
   },
   {
    "ReadOnly": true,
    "Source": "mdf-unit_mdf-cpu-server",
    "Target": "/opt/llama",
    "Type": "volume",
    "VolumeOptions": {
     "NoCopy": true,
     "Subpath": "llama"
    }
   },
   {
    "ReadOnly": true,
    "Source": "mdf-unit_mdf-cpu-server",
    "Target": "/models",
    "Type": "volume",
    "VolumeOptions": {
     "NoCopy": true,
     "Subpath": "gguf"
    }
   },
   {
    "ReadOnly": false,
    "Source": "mdf-unit_mdf-run",
    "Target": "/relay",
    "Type": "volume",
    "VolumeOptions": {
     "NoCopy": true,
     "Subpath": "sock/mdf-eng-0123456789abcdef/llama"
    }
   }
  ],
  "NetworkMode": "none",
  "PidsLimit": 64,
  "Privileged": false,
  "ReadonlyRootfs": true,
  "RestartPolicy": {
   "MaximumRetryCount": 0,
   "Name": "no"
  },
  "SecurityOpt": [
   "no-new-privileges"
  ],
  "ShmSize": 67108864,
  "Tmpfs": {
   "/tmp": "rw,nosuid,nodev,size=16m"
  },
  "Ulimits": [
   {
    "Hard": 0,
    "Name": "core",
    "Soft": 0
   },
   {
    "Hard": 67108864,
    "Name": "fsize",
    "Soft": 67108864
   },
   {
    "Hard": 256,
    "Name": "nofile",
    "Soft": 256
   }
  ]
 },
 "Image": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
 "Labels": {
  "mdf.attempt": "mdf-eng-0123456789abcdef",
  "mdf.kind": "cpuserver",
  "mdf.lease": "30",
  "mdf.max": "120",
  "mdf.project": "mdf-unit",
  "mdf.t0": "1000.0"
 },
 "NetworkDisabled": true,
 "OpenStdin": false,
 "StdinOnce": false,
 "Tty": false,
 "User": "1000:1000",
 "WorkingDir": "/tmp"
}
