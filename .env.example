# Settings of the product (API, worker and CLI): give the same file to every process,
#   mdf --env-file /path/to/mdf.env serve|worker|submit|convert ...
# Precedence: defaults < explicit file < environment < administrative CLI arguments.
# Unknown MDF names and invalid values cause an error. No secret belongs here: the Datalab key is
# DATALAB_API_KEY in the environment of the worker only (docs/how-to/convert-documents.md). The processes read
# only the MDF_ lines of this file; `mdf worker --env-file` wants it a regular file of yours with mode 0600.

# --- Archive and processes
MDF_DATA_ROOT=./mdf-data
# Not part of the archive identity (schema 3). An archive of a previous version (identity schema 1
# or 2) created with a former default port needs it here once, until its first opening upgrades it:
# 23460, or 8765 before 2026-11-07; one created with the former default model root needs once
# MDF_MODEL_ROOT set to the absolute path of that mdf-models directory (or ./mdf-models from the
# directory it was used from).
MDF_PORT=23465
MDF_HOST=127.0.0.1
# The only profile: conversions run on the engine, which records its versions in engine.json.
MDF_BIND_PROFILE=engine-v1
MDF_REVIEW_PROVIDER=disabled
# Archive quota, without automatic deletion; free reserve space kept distinct.
MDF_STORAGE_MIB=20480
MDF_RESERVE_MIB=1024
MDF_UPLOAD_MIB=50
MDF_POLL_SECONDS=1
MDF_LEASE_SECONDS=15
MDF_GRACE_SECONDS=5

# --- Conversion engine (mdf convert and the worker)
# The 18 weight files of the Marker route (indra-ocr v1.1.0 and GoNoto), prepared once with
# `mdf prepare --weights` and verified before every conversion; no download during a conversion.
# Default ${XDG_CACHE_HOME:-~/.cache}/markdown-for-llms/models; not part of the archive identity.
# MDF_MODEL_ROOT=~/.cache/markdown-for-llms/models
# Total deadline of a conversion in seconds; 0 = none (default): stop it with Cancel.
MDF_TIMEOUT_SECONDS=0
# Stop a conversion whose Marker child writes no progress event and uses no CPU time for this
# long (minimum 60). 900 is an initial default, not a guarantee.
MDF_STALL_SECONDS=900
# Memory cap of each tool container and of the systemd scope of the Marker child (a true cap on
# the whole child; without a systemd user manager the Marker route is unavailable).
MDF_MEMORY_MIB=16384
MDF_THREADS=4
MDF_PROCESS_LIMIT=512
MDF_MAX_PAGES=50
MDF_OUTPUT_MIB=512
MDF_LOG_MIB=10
MDF_MAX_PIXELS=25000000
MDF_MAX_DIMENSION=16000

# --- Datalab, a remote route chosen per document
# Spending cap in USD of one conversion with Datalab; 0 (default) sends nothing. With a cap above 0
# and DATALAB_API_KEY in the environment of the worker, the Web UI offers Datalab with the transit
# notice and a mandatory confirmation. Not part of the archive identity.
MDF_DATALAB_CAP_USD=0

# --- Rented GPUs of the marker-server route in the archive (MFL023); none of these is part of the archive identity.
# The GPU presets this instance enables: comma-separated names of markdown_for_llms/gpu/data/presets.json, only
# supported presets on a network volume (modal-base, runpod-serverless-volume-dc); empty (default): none.
# MDF_GPU_PRESETS=
# The servers.json of the instance: its endpoints, without secrets; an endpoint names its GPU preset.
# MDF_SERVERS=~/.config/markdown-for-llms/servers.json
# The folder of the spend ledger of the instance (spend.jsonl, its lock, the logs of the GPU workers), outside
# MDF_DATA_ROOT and MDF_MODEL_ROOT; give the same folder to `mdf bench run --runs-dir` to share the ledger.
# MDF_GPU_LEDGER_DIR=~/.local/share/markdown-for-llms/gpu-ledger
# Caps in USD of the ledger for each provider (0, the default: the presets of that provider are not available),
# and of one GPU session.
# MDF_GPU_CAP_USD_MODAL=0
# MDF_GPU_CAP_USD_RUNPOD=0
# MDF_GPU_SESSION_CAP_USD=0

# --- mdf bench (MFL026): put MDF_BENCH_* values in the file given to `mdf bench ... --env-file`, never in the
# environment (scripts/full-check.sh stops when an MDF_* variable is exported). Ports of the project block.
# The cache of the reference set (sources, derived inputs, checks), default ~/.cache/markdown-for-llms/bench;
# `--cache DIR` wins over it. Read from this file by the commands that take a settings file (prepare, list,
# fetch, checks); `run`, `report` and `crosscheck` read no settings file, so for them pass --cache or set
# MDF_BENCH_CACHE_DIR on their own command line; `compare`, `spend` and `secret-scan` read no settings file
# and no cache.
# MDF_BENCH_CACHE_DIR=~/.cache/markdown-for-llms/bench
# MDF_BENCH_RELAY_PORT=23461
# MDF_BENCH_INFERENCE_PORT=23463
# Memory cap of each external tool call of the bench (reference toolchain container), MiB, 64-1048576.
# MDF_BENCH_TOOL_MEMORY_MB=8192
# Runs folder of `mdf bench run`: it reads no settings file, so pass --runs-dir or set the variable on its
# command line only.
# MDF_BENCH_RUNS_DIR=~/.local/share/markdown-for-llms/bench/runs
# Default of `mdf bench run --spend-cap-usd`: the cap in USD (0-1000) of the Datalab spend ledger of the runs
# folder (spend.jsonl), all runs together; like the runs folder, set it on the command line of `run` only.
# The keys of `run` and `secret-scan` (Datalab, RunPod, Modal) come from the file given to their --env-file, a
# file of keys only, never from here.
# MDF_BENCH_CAP_DATALAB_USD=4.00

# --- Keys of the remote services: never in the settings file of the service, never in git.
# Put them, one NAME=value per line, in a file of yours with mode 0600 that git ignores (the .env of the root
# of a clone), and give it with --env-file to `mdf convert` (which reads its settings from it too),
# `mdf bench run`, `mdf bench secret-scan` and the scripts of scripts/servers/. The worker of the service reads
# DATALAB_API_KEY from its own environment only, and takes the keys of the rented GPUs out of its environment when
# it starts. The names of the keys of an endpoint (key_env of servers.json) end in _KEY, _SECRET, _TOKEN, _TOKEN_ID
# or _BEARER. No command prints or writes a key (`mdf bench secret-scan` checks it). Names only here
# (docs/how-to/convert-documents.md):
# Datalab, the remote route chosen per document:
# DATALAB_API_KEY=
# RunPod, an API key restricted to the endpoint of the marker-server route (Authorization: Bearer):
# RUNPOD_API_KEY=
# Modal, the proxy token of the workspace of the app (Modal-Key and Modal-Secret, `wk-...` and `ws-...`); not
# the token of the SDK, which `modal token new` keeps in ~/.modal.toml:
# MODAL_PROXY_TOKEN_ID=
# MODAL_PROXY_TOKEN_SECRET=
# The same proxy token as one bearer, <token id>.<token secret>, for an endpoint of kind `user` on Modal:
# MODAL_PROXY_BEARER=
