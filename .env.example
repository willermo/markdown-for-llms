# Configurazione effettiva legacy del workspace; la shell prevale su .env.
# Backend locale/cloud selezionato nel JSON; nessuna chiave reale in questo file.
MARKER_API_KEY=
CHUNK_SIZE=4000
OVERLAP_SIZE=200
TARGET_LLM=custom
MAX_WORKERS=3
LOG_LEVEL=INFO
CONVERSION_TIMEOUT=3600
CONNECT_TIMEOUT=30
MARKER_LOCAL_BASE_URL=http://localhost:8000
MARKER_LOCAL_ENDPOINT=/convert
# Il cloud è opzionale: configurarlo esplicitamente nel JSON e fornire la chiave.
# MARKER_CLOUD_BASE_URL=https://www.datalab.to/api/v1
# MARKER_CLOUD_ENDPOINT=/marker
# MARKER_BASE_URL=  # Alias legacy della base URL cloud.
MARKER_USE_LLM=false
MARKER_FORCE_OCR=false
MARKER_STRIP_EXISTING_OCR=true
MARKER_DISABLE_IMAGE_EXTRACTION=true
MARKER_PAGINATE=false
MAX_POLLS=300
POLL_INTERVAL=2
# Lista non-PDF opt-in; vuota non cancella la lista JSON.
# MARKER_DOCUMENT_FORMATS=epub,docx,html,pptx,xlsx,png
# Cache tiktoken preparata fuori test; nessun download implicito durante le prove.
# TIKTOKEN_CACHE_DIR=/percorso/assoluto/cache-tokenizer
